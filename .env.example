# PostgreSQL service configuration — must match Docker Compose service definitions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fintech_db

# SQLAlchemy async connection URL
# IMPORTANT: hostname must be "postgres" (the Compose service name) when running inside Docker
# For local tests outside Docker, use "localhost" instead
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/fintech_db

# Stripe API key — MUST begin with sk_test_ (validated at app startup in Story 1.4)
STRIPE_API_KEY=sk_test_replace_with_your_test_key_here

# Path to the Ed25519 PKCS8 public key PEM file used for mandate verification
# In Docker: mounted at /app/keys/public_key.pem via Compose volume
# Locally: relative path keys/public_key.pem also works
PUBLIC_KEY_PATH=/app/keys/public_key.pem
